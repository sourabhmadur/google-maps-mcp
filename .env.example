# Required: a Google Maps Platform API key with Places API (New), Geocoding API,
# Directions API, Distance Matrix API, and Geolocation API enabled.
GOOGLE_MAPS_API_KEY=your_key_here

# Optional: a fallback location used when no GPS/IP location can be determined,
# formatted as "lat,lng" (e.g., "37.7749,-122.4194" for San Francisco).
GOOGLE_MAPS_DEFAULT_LOCATION=

# Optional: skip CoreLocation even on macOS (set to 1 to force IP-based fallback).
GOOGLE_MAPS_DISABLE_CORELOCATION=
